# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file.

# Required. Get it from @BotFather. Looks like 123456789:AAExampleTokenHere
BOT_TOKEN=

# Only needed for webhook mode. Must start with https://
WEBHOOK_URL=

# Optional. A random string; Telegram sends it back so we know the request is real.
WEBHOOK_SECRET=

# Comma-separated Telegram user IDs of admins. Example: 111111,222222
ADMIN_IDS=

# Where sessions are stored: file | redis | pdo
STORAGE_DRIVER=file

# Folder used by the "file" driver. Leave empty to use <project>/storage
STORAGE_PATH=

# Default format for messages: HTML | MarkdownV2 | none
PARSE_MODE=HTML

# debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=info
