{
    "name": "botforge/botforge",
    "description": "A small PHP framework for building Telegram bots",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^8.6",
        "monolog/monolog": "^3.13",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Botforge\\": "src/",
            "DemoBot\\": "examples/demo-bot/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
